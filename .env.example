# Required — Sponsor Pack pipeline
ANTHROPIC_API_KEY=sk-ant-...
GAMMA_API_KEY=sk-gamma-...
GRADIUM_API_KEY=gsk_...

# Public base URL used to build absolute video links for other apps
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — skip Gamma landing page generation during demos
MOCK_LANDING_PAGE=false

# Optional — where generated media is written (default: public/generated)
# OUTPUT_DIR=public/generated

